{
  "manifest_version": 2,
  "name": "Senda Labs",
  "version": "1.1",
  "description": "Applies the custom CSS and script the user writes in Senda Labs, isolated from the pages",
  "incognito": "not_allowed",
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "labs@senda.org"
    }
  },
  "background": {
    "scripts": ["background.js"]
  }
}
