{
  "manifest_version": 2,
  "name": "Senda Tor & Proxy Controller",
  "version": "1.1",
  "description": "Control soberano de enrutamiento Tor y Proxies en Senda Browser",
  "permissions": [
    "proxy",
    "storage",
    "privacy",
    "geckoViewAddons",
    "nativeMessaging",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "proxy@senda.org"
    }
  },
  "background": {
    "scripts": ["background.js"]
  }
}